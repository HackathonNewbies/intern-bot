# Copy to .env; never commit credentials.
MODEL_PROVIDER=openai
OPENAI_API_KEY=
MODEL=gpt-5.6-sol

# Optional alternative: MODEL_PROVIDER=openrouter and an available MODEL slug.
# OPENROUTER_API_KEY=

# Managed Slack: follow apps/channel/README.md.
# Preferred name; INTELLIGENCE_API_KEY remains supported as a fallback.
CPK_INTELLIGENCE_API_KEY=
CHANNEL_CODE=
LOG_LEVEL=debug
PORT=3000

# Shared Google Calendar (see dev-docs/google-calendar.md).
GOOGLE_CALENDAR_ID=
GOOGLE_OAUTH_CLIENT_FILE=.data/google-oauth-client.json

# Inherited incident-demo tools; not needed for the planned Intern Bot.
# Leave these unset unless intentionally testing those example integrations.
# EXA_API_KEY=
# EXA_SEARCH_TYPE=fast
# AMBIGUOUS_API_KEY=

# Task A private selected-thread workflow (optional owner-bound Slack OAuth).
# INTERN_SLACK_USER_TOKEN=
# INTERN_SLACK_BOT_TOKEN=
# Paths are relative to apps/channel when using npm run dev:slack.
# INTERN_DATA_DIR=../../.data/intern
# INTERN_VERIFIED_DM_BINDINGS=../../.data/intern-dm-bindings.json
